{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "cd frontend && npm run build",
      "outputDirectory": "frontend/dist",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "VITE_API_TARGET"
        }
      ]
    },
    "backend": {
      "root": "backend",
      "framework": "fastapi",
      "buildCommand": ".venv/bin/python -m pip install -e . && echo 'ready'",
      "startCommand": ".venv/bin/python -m uvicorn backend.app.main:app --host 0.0.0.0 --port $PORT"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
