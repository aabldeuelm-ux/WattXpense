# WattXpense configuration.
#
# Copy to .env and edit. .env is git-ignored; this file is not, so keep it free of secrets.
#
# WattXpense reads configuration from environment variables. It does not read this file
# automatically, so either export the values or load them yourself, for example:
#
#   set -a && . ./.env && set +a && .venv/bin/python -m uvicorn backend.app.main:app
#
# Every value below is optional. The defaults shown are what the app uses when unset.

# ---------------------------------------------------------------------------------------
# Local language model (Ollama) for written explanations
# ---------------------------------------------------------------------------------------
# The dashboard, billing and forecasts work with all of this left off. Generated text is a
# separate, optional layer on top of WattXpense's own calculations.
#
# Set WATTXPENSE_LLM_MODEL to a model you have pulled. There is no default model name in the
# code on purpose: an empty model means generated text stays switched off.
#
#   ollama serve                        # start the local server
#   ollama pull qwen2.5:7b              # fetch a model
#   ollama list                         # see what you have
#
# Turn the whole feature off without unsetting anything else.
WATTXPENSE_LLM_ENABLED=true

# Which registered provider to use. Only "ollama" ships today; others can be added in
# energy_ai/llm/__init__.py without touching any other module.
WATTXPENSE_LLM_PROVIDER=ollama

# Where the local model server is listening. No trailing slash needed.
WATTXPENSE_LLM_BASE_URL=http://127.0.0.1:11434

# The model to use. Must already be pulled, otherwise explanations fall back to the
# calculated summary and the UI shows that AI is unavailable.
WATTXPENSE_LLM_MODEL=

# How long to wait for the model before giving up. Small models on a laptop can take a while
# for a first reply; raise this if you see timeouts. Max 600.
WATTXPENSE_LLM_TIMEOUT_SECONDS=60

# 0 is most literal, 1 is most creative. Low values keep the model close to the supplied
# figures instead of embellishing them.
WATTXPENSE_LLM_TEMPERATURE=0.2

# How long Ollama keeps the model loaded after a request, e.g. 5m, 30s, or 0 to unload now.
# A few minutes avoids paying model load time on every refresh.
WATTXPENSE_LLM_KEEP_ALIVE=5m

# ---------------------------------------------------------------------------------------
# Accounts, sessions and device access
# ---------------------------------------------------------------------------------------
# The dashboard is private: every device, reading, tariff, forecast and insight is scoped to
# the signed-in account. Sessions use an HttpOnly cookie; state-changing requests also need a
# CSRF token. Set WATTXPENSE_COOKIE_SECURE=true when the app is served over HTTPS.

# How long a session lasts before it has to be renewed by signing in again.
# WATTXPENSE_SESSION_TTL_HOURS=168

# Mark the session and CSRF cookies Secure. Leave false for plain-HTTP local development;
# set true behind HTTPS.
# WATTXPENSE_COOKIE_SECURE=false

# Allow new accounts to be created from the sign-in screen. Set false on a private install
# and create the first account before turning it off.
# WATTXPENSE_REGISTRATION_ENABLED=true

# Failed sign-ins allowed before an account is temporarily locked, and for how long.
# WATTXPENSE_LOGIN_MAX_ATTEMPTS=5
# WATTXPENSE_LOGIN_LOCKOUT_MINUTES=15

# ---------------------------------------------------------------------------------------
# Hardware safety
# ---------------------------------------------------------------------------------------
# Relay control is off for the whole installation unless this is explicitly true. Even then,
# each device has its own relay_enabled flag (default false). Commands are recorded as
# pending until firmware acknowledges them, and WattXpense never switches a relay
# automatically. Read docs/HARDWARE.md before connecting mains wiring.
# WATTXPENSE_RELAY_CONTROL_ENABLED=false

# ---------------------------------------------------------------------------------------
# Core app settings (shown for reference; the defaults apply when unset)
# ---------------------------------------------------------------------------------------
# WattXpense is set up for an Indian household by default: IST, rupees, 230 V at 50 Hz, an
# evening peak window, and a progressive slab tariff. Change any of these to match your own
# supply and tariff.

# Indian Standard Time. Day boundaries, billing periods and forecasts all follow this.
# WATTXPENSE_TIMEZONE=Asia/Kolkata

# WATTXPENSE_CURRENCY=INR

# Slab tariffs, priced block by block. This default is a worked example of the shape of an
# Indian domestic slab tariff, NOT any particular DISCOM's published schedule. Replace it with
# the real numbers from your bill, or set the tariff from the dashboard's tariff panel.
# The last block must be left open (null) so units above the highest boundary are still billed.
# WATTXPENSE_DEFAULT_SLABS=[{"up_to_kwh":100,"rate_per_kwh":2.5},{"up_to_kwh":300,"rate_per_kwh":4.5},{"up_to_kwh":500,"rate_per_kwh":6.5},{"up_to_kwh":null,"rate_per_kwh":8.0}]

# WATTXPENSE_DEFAULT_TARIFF_NAME=Generic India domestic (example slab tariff)
# WATTXPENSE_DEFAULT_RATE_TYPE=slab

# Only used when the rate type is flat rather than slab.
# WATTXPENSE_FLAT_RATE_PER_KWH=0

# The daily fixed/standing charge, in rupees per day.
# WATTXPENSE_STANDING_CHARGE_PER_DAY=2.5

# Electricity duty. Applied to the energy charge only, not to the fixed charge, which is the
# usual Indian treatment. Labelled "Electricity duty" whenever the currency is INR.
# WATTXPENSE_TAX_PERCENT=5

# WATTXPENSE_BILLING_START_DAY=1

# Evening peak window, for time-of-use tariffs.
# WATTXPENSE_PEAK_START_HOUR=18
# WATTXPENSE_PEAK_END_HOUR=22

# WATTXPENSE_STALE_READING_MINUTES=15
# WATTXPENSE_NOMINAL_VOLTAGE_V=230
# WATTXPENSE_NOMINAL_FREQUENCY_HZ=50
# WATTXPENSE_VOLTAGE_TOLERANCE_PERCENT=10
# WATTXPENSE_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# WATTXPENSE_DATABASE_URL=sqlite:///backend/data/wattxpense.db

# Pin "now" for demos and deterministic tests. Leave unset in normal use.
# WATTXPENSE_SIMULATED_NOW=2026-09-26T05:00:00Z
